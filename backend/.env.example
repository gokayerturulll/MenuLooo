# MenuLo Backend — Environment Variables (Template)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# docker compose reads backend/.env as an OPTIONAL env_file: the stack comes up
# without it, but the backend refuses to start without a valid JWT_SECRET.

# ── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────
# docker compose overrides DB_HOST/DB_PORT (db:5432). These values are for
# running the backend outside Docker with `npm run dev` — note port 5433,
# which is what compose publishes on the host.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=menulo_db
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=20

# ── JWT ─────────────────────────────────────
# Must be at least 32 characters — server.js exits on startup otherwise.
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS (REST + Socket.io share this list) ──
# Required in production: if empty, the server exits instead of falling back
# to wildcard CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── iOS APNs (Push Notification) ────────────
# Push is silently disabled unless KEY_PATH + KEY_ID + TEAM_ID are all set.
# APN_KEY_PATH points to the .p8 file (path is resolved relative to backend/).
APN_KEY_PATH=
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=com.menulo.app

# Deep-link prefix used in password-reset links
APP_URL=menulo://

# ── AI Providers (MenuBot) ──────────────────
# GEMINI: embeddings (gemini-embedding-001), both seeding and query side
# GROQ  : intent classification + answer generation (llama-3.1-8b / 3.3-70b)
# Without these the backend still runs; only /api/menubot/ask fails.
GEMINI_API_KEY=
GROQ_API_KEY=
